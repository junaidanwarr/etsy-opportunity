# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=4174

# Your brand and domain (used for canonical links, sitemap and Open Graph tags)
SITE_NAME=Foundry
SITE_URL=https://www.your-domain.com

# Shown on the "request received" page so customers can reach you directly
CONTACT_EMAIL=hello@your-domain.com
CONTACT_WHATSAPP=+92 300 0000000
REPLY_TIME=2 working days

# Security: use long random values (e.g. `node -e "console.log(crypto.randomBytes(24).toString('base64url'))"`)
ADMIN_PASSWORD=replace-with-a-long-random-password
RADAR_INGEST_TOKEN=replace-with-a-different-long-random-token

# Storage: set both TURSO_* values to use Turso (required on Vercel). Leave them unset to use the local file below.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATABASE_PATH=data/foundry.sqlite

# Behaviour
# true = Radar discoveries go live immediately; false = they wait for approval in /admin
AUTO_APPROVE=false
# Items discovered within this many days get the "New" badge; older ones are in the archive filter
NEW_DAYS=7
# Admin shows a warning if no Radar report arrived within this many hours
STALE_AFTER_HOURS=36

# Email alerts: every new workflow request is emailed to NOTIFY_EMAIL through your own mailbox's SMTP server.
# Namecheap shared hosting: use the server name (e.g. premium164.web-hosting.com), NOT mail.your-domain.com,
# because that name points at Cloudflare when the domain uses Cloudflare. Port 465 = TLS, 587 = STARTTLS.
NOTIFY_EMAIL=team@100daysforai.com
MAIL_FROM="Foundry <team@100daysforai.com>"
SMTP_HOST=premium164.web-hosting.com
SMTP_PORT=465
SMTP_USER=team@100daysforai.com
SMTP_PASS=

# Optional: a Slack/Discord-style incoming webhook that gets a message for each new request and report
NOTIFY_WEBHOOK_URL=

# Set to true only when running behind a reverse proxy (Caddy/Nginx) so rate limits see the real client IP
TRUST_PROXY=false

# Workflow videos: HTTPS YouTube links or direct .mp4 URLs
WORKFLOW_VIDEO_1_URL=
WORKFLOW_VIDEO_2_URL=
